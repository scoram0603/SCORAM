{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ScoramAPI",
    "Audience": "ScoramClient",
    "ExpiryMinutes": "1440"
  },
  "Meilisearch": {
    "Url": "http://localhost:7700",
    "ApiKey": ""
  },
  "AzureBlobStorage": {
    "_COMMENT": "DEMO ONLY -- REPLACE ConnectionString WITH YOUR REAL AZURE STORAGE CONNECTION STRING. Azure Portal -> scoramstorage -> Security + networking -> Access keys -> Key 1 -> Connection string. Never commit the real value -- see appsettings.Production.json (gitignored) or environment variables instead.",
    "ConnectionString": "",
    "ContainerName": "uploads",
    "MaxFileSizeMB": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/scoram-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
