# Copy this file to .env and point it at your running ScoramAPI backend.
#
# Visual Studio / `dotnet run` can launch either the "http" or "https" profile
# (see ScoramAPI/Properties/launchSettings.json) — pick the ONE you're actually
# running and match its port exactly, including http vs https:
#   - running the "http" profile  -> http://localhost:5192
#   - running the "https" profile -> https://localhost:7192
# Mismatching the protocol (http vs https) or port is the most common cause of
# "Couldn't reach the Scoram API" / CORS errors during local development.
VITE_API_BASE_URL=http://localhost:5192
